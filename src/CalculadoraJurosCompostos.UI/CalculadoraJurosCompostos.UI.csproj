<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CalculadoraJurosCompostos</RootNamespace>
    <AssemblyName>CalculadoraJurosCompostos</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Habilitar junto com a limpeza do Form1: os handlers de evento declaram
         (object sender, ...) e o delegate moderno espera (object?, ...). -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>CalculadoraJurosCompostos</Product>
    <Copyright>Copyright © 2024</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
